# Tesseralbum · environment
#
# One value, and it is public by design. An OAuth client id ships in every page
# that uses Google sign-in; what protects the account is the authorised-origins
# list in Google Cloud, not the secrecy of this string.
#
# There is no client secret (the browser token flow does not use one) and no
# service key (there is no server holding one).

NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# La dirección pública del álbum, sin barra final. Es la que se graba en los
# chips NFC, y por eso la app se niega a grabar uno si no la estás usando: una
# pegatina lleva una URL absoluta para siempre.
NEXT_PUBLIC_SITE_URL=
